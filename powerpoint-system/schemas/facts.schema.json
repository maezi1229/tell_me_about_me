{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "facts",
  "description": "Structured, sourced facts the deck may cite. No claim should reach slides.yaml without a corresponding entry here.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "claim", "confidence"],
    "properties": {
      "id": { "type": "string", "pattern": "^F[0-9]+$" },
      "claim": { "type": "string" },
      "value": { "description": "The number/fact itself, if applicable" },
      "unit": { "type": ["string", "null"] },
      "confidence": { "type": "string", "enum": ["confirmed", "inferred", "unknown"] },
      "source_id": { "type": ["string", "null"], "pattern": "^SRC[0-9]+$" },
      "notes": { "type": ["string", "null"] }
    },
    "additionalProperties": false
  }
}
